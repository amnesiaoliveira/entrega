# Configure no ambiente do processo; este arquivo não é carregado automaticamente.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=substitua-por-uma-chave-aleatoria
DJANGO_ALLOWED_HOSTS=entregas.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://entregas.seudominio.com
DJANGO_TIME_ZONE=America/La_Paz
DJANGO_HTTPS=1
# DJANGO_HTTPS=0 somente para HTTP na rede local (sem instalação PWA remota).
# O instalador usa DJANGO_CONFIG_FILE apontando para production.json privado.
# DJANGO_DATABASE_PATH=C:\ProgramData\SuperBaranda\db.sqlite3
